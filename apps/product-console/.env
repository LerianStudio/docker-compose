NODE_ENV=production

# OpenTelemetry Configuration
# Set to true when running with a full Midaz infrastructure that includes an OTel collector
ENABLE_TELEMETRY=false
OTEL_RECEIVER_HTTP_PORT=4318
# Use 'infra' if connecting to the Midaz infra OTel collector, or 'midaz-otel-lgtm' for standalone
OTEL_HOST='midaz-otel-lgtm'
OTEL_URL_METRICS='http://${OTEL_HOST}:${OTEL_RECEIVER_HTTP_PORT}/v1/metrics'
OTEL_URL_TRACES='http://${OTEL_HOST}:${OTEL_RECEIVER_HTTP_PORT}/v1/traces'
OTEL_URL_LOGS='http://${OTEL_HOST}:${OTEL_RECEIVER_HTTP_PORT}/v1/logs'

# Plugin Auth
PLUGIN_AUTH_ENABLED=true
NEXT_PUBLIC_PLUGIN_AUTH_ENABLED=${PLUGIN_AUTH_ENABLED}
PLUGIN_AUTH_CLIENT_ID='your-client-id'
PLUGIN_AUTH_CLIENT_SECRET='your-client-secret'
PLUGIN_AUTH_HOST='plugin-auth'
PLUGIN_AUTH_PORT=4000
PLUGIN_AUTH_BASE_PATH='http://${PLUGIN_AUTH_HOST}:${PLUGIN_AUTH_PORT}/v1'

# Plugin Identity Configuration
PLUGIN_IDENTITY_HOST='plugin-identity'
PLUGIN_IDENTITY_PORT=4001
PLUGIN_IDENTITY_BASE_PATH='http://${PLUGIN_IDENTITY_HOST}:${PLUGIN_IDENTITY_PORT}/v1'

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:8081"
NEXTAUTH_SECRET="SECRET"

# Midaz API Configuration
MIDAZ_API_HOST='onboarding'
MIDAZ_API_PORT=3000
MIDAZ_BASE_PATH='http://${MIDAZ_API_HOST}:${MIDAZ_API_PORT}/v1'
MIDAZ_TRANSACTION_BASE_HOST='transaction'
MIDAZ_TRANSACTION_BASE_PORT=3001
MIDAZ_TRANSACTION_BASE_PATH='http://${MIDAZ_TRANSACTION_BASE_HOST}:${MIDAZ_TRANSACTION_BASE_PORT}/v1'

# Midaz Plugins Configuration
CRM_BASE_PATH='http://crm-plugin:4003/v1/'

# Plugin Fees Configuration
PLUGIN_FEES_HOST='plugin-fees'
PLUGIN_FEES_PORT=4002
PLUGIN_FEES_BASE_PATH='https://${PLUGIN_FEES_HOST}:${PLUGIN_FEES_PORT}/v1'

# Reporter Configuration
REPORTER_BASE_PATH='http://reporter:3002/v1'

# Matcher Configuration
MATCHER_BASE_PATH='http://matcher:8080/api/v1'

# MongoDB Configuration
MONGODB_URI='mongodb://${MONGODB_USER}:${MONGODB_PASS}@midaz-mongodb:5703/?directConnection=true'
MONGODB_DB_NAME='midaz-console'
MONGODB_USER='midaz'
MONGODB_PASS='your-mongodb-password'

# General Configuration
NEXT_PUBLIC_MIDAZ_CONSOLE_AVATAR_ALLOWED_FORMAT='jpeg,jpg,png,svg+xml'
NEXT_PUBLIC_MIDAZ_APPLICATION_OPTIONS=midaz,plugin-fees,plugin-crm,reporter
NEXT_PUBLIC_DEMO_MODE=false

# Account Types Validation
MIDAZ_ACCOUNT_TYPE_VALIDATION_ENABLED=false
MIDAZ_ACCOUNT_TYPE_VALIDATION=
